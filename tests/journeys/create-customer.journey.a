test("an operator saves a customer") {
  step("open the new customer form") {
    go("/customers/new")
    expectHeading("New customer")
  }
  step("fill name Acme Supplies and email ap@acme.test and save") {
    fill("Name", "Acme Supplies")
    fill("Email", "ap@acme.test")
    click("Save")
    expectUrl("/customers/cus_*")
  }
  step("see the Acme Supplies customer page") {
    reload()
    expectHeading("Acme Supplies")
    scan()
  }
}
